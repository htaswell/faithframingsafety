# Data: never commit raw or intermediate data. Only the synthetic example
# under data/example/ is tracked.
data/raw/*
!data/raw/.gitkeep
data/interim/
*.xlsx
*.xls
!data/example/*.csv

# Results: regenerate these with `make all`.
results/*
!results/.gitkeep

# Credentials. Never commit an API key.
.env
*.key
secrets*

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
