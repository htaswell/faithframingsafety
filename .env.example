# Copy to .env and fill in, or export directly in your shell.
# .env is gitignored. Never commit a real key.
#
#   export ANTHROPIC_API_KEY="sk-ant-..."
#
# Only the LLM annotation step (Pipeline B, step 1) needs this. The lexicon
# pipeline and all statistical tests run without any credentials, and the
# annotation step can be run with --mock to skip the API entirely.
ANTHROPIC_API_KEY=
